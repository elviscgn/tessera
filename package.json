{
  "name": "tessera",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "src/renderer/register-loaders.js"
  ],
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.18.1",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "tool:versions": "node --version && pnpm --version && tsc --version && vite --version && vitest --version && eslint --version && prettier --version",
    "format": "prettier . --write && cargo fmt --manifest-path rust/Cargo.toml --all",
    "check:format": "prettier . --check && cargo fmt --manifest-path rust/Cargo.toml --all -- --check",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "check:rust": "cargo clippy --manifest-path rust/Cargo.toml --workspace --all-targets -- -D warnings && cargo test --manifest-path rust/Cargo.toml --workspace --all-targets",
    "build:wasm": "node scripts/build-wasm.mjs",
    "check:wasm": "pnpm build:wasm",
    "dev": "vite",
    "build": "pnpm build:wasm && vite build",
    "check:production-testkit": "node scripts/check-production-testkit.mjs",
    "quality:fallow": "node scripts/check-fallow-policy.mjs && fallow audit --format compact --fail-on-issues",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e/scenario-lab.spec.ts --project=chromium",
    "test:e2e:production": "TESSERA_E2E_MODE=production playwright test tests/e2e/production.spec.ts --project=chromium",
    "test:e2e:compat": "playwright test tests/e2e/compatibility.spec.ts --project=firefox --project=webkit",
    "test:visual": "playwright test tests/visual --project=chromium",
    "test:visual:update": "playwright test tests/visual --project=chromium --update-snapshots",
    "perf:native": "node scripts/run-native-performance.mjs",
    "perf:native:check": "node scripts/run-native-performance.mjs --compare tests/fixtures/performance/native-baseline.json",
    "perf:browser": "node scripts/run-browser-performance.mjs",
    "check:js": "pnpm check:format && pnpm lint && pnpm typecheck && pnpm test && pnpm quality:fallow",
    "check": "pnpm check:js && pnpm check:rust && pnpm check:wasm && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.60.0",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "fallow": "3.10.0",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@babylonjs/core": "9.19.0",
    "@babylonjs/loaders": "9.19.0"
  }
}
